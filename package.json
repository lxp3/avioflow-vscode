{
  "name": "avioflow",
  "displayName": "Avioflow",
  "description": "High-performance audio engine and toolkit for VS Code",
  "version": "0.4.0",
  "publisher": "lxp3",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxp3/avioflow-vscode"
  },
  "bugs": {
    "url": "https://github.com/lxp3/avioflow-vscode/issues"
  },
  "homepage": "https://github.com/lxp3/avioflow-vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCustomEditor:avioflow.audioPreview",
    "onView:avioflow.homeView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avioflow-explorer",
          "title": "Avioflow",
          "icon": "$(music)"
        }
      ]
    },
    "views": {
      "avioflow-explorer": [
        {
          "type": "webview",
          "id": "avioflow.homeView",
          "name": "Avioflow Home"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "avioflow.audioPreview",
        "displayName": "Avioflow Audio Preview",
        "selector": [
          {
            "filenamePattern": "*.{aac,ac3,aiff,aif,aifc,alaw,ape,asf,au,avi,dsf,f32be,f32le,f64be,f64le,flac,flv,m4v,matroska,mka,webm,mov,mp4,m4a,3gp,3g2,mj2,mp3,mpc,mpc8,mulaw,ogg,oga,opus,rm,s16be,s16le,s24be,s24le,s32be,s32le,s8,shn,tak,tta,u16be,u16le,u24be,u24le,u32be,u32le,u8,wav,wave,wma,wv,xwma}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "avioflow.openAudioFile",
        "title": "Open Audio File",
        "category": "Avioflow"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "fetch:wasm": "node scripts/fetch-wasm.mjs",
    "build": "npm run fetch:wasm && npm run compile",
    "package": "npx vsce package --no-dependencies",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build webview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "lucide-svelte": "^0.563.0"
  }
}
